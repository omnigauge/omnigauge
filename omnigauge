def build_id():
    """A short fingerprint of THIS file's bytes - what a bug report needs and
    what a long-running board compares against to notice it is stale."""
    import hashlib
    try:
        with open(os.path.realpath(__file__), "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()[:8]
    except OSError:
        return "unknown"


_BUILD_AT_START = None


def binary_changed():
    """True once the file this process was launched from has been rewritten.
    A --watch left running through an install kept drawing yesterday's code -
    a session reset rendered as a wall clock for hours after the fix landed.
    The board says so and re-execs itself rather than lying quietly."""
    global _BUILD_AT_START
    cur = build_id()
    if _BUILD_AT_START is None:
        _BUILD_AT_START = cur
        return False
    return cur != _BUILD_AT_START


def reexec():
    sys.stdout.write("\033[?25h\033[?1049l")
    sys.stdout.flush()
    os.execv(sys.executable, [sys.executable] + sys.argv)


def _update_plan(exe=None, here=None, data=None, dist_ok=None):
    """Decide HOW this install updates - from evidence only. pipx shows in the
    interpreter's prefix; a clone shows as a .git beside the file, or through
    the source path install.sh stamps into the data dir (the installed copy is
    a plain file in ~/.local/bin with no .git beside it - v1.0.4 misread that
    as a pip install and ran pip at a clone user); pip counts only when the
    package's own dist metadata exists. No evidence -> no command: refusing
    beats running a plausible installer against the wrong install.
    Returns (cmd, shown, kind, srcdir). Arguments exist for the tests."""
    exe = exe or sys.executable
    here = here or os.path.dirname(os.path.realpath(__file__))
    data = data or DATA
    if "/pipx/venvs/omnigauge" in exe.replace("\\", "/"):
        return ["pipx", "upgrade", "omnigauge"], "pipx upgrade omnigauge", "pipx", None
    if shutil.which("git"):
        for c in (here, os.path.join(here, "..")):
            if os.path.isdir(os.path.join(c, ".git")):
                return (["git", "-C", here, "pull", "--ff-only"],
                        f"git -C {here} pull", "clone", here)
        stamp = os.path.join(data, "source")
        if os.path.isfile(stamp):
            try:
                src = open(stamp, encoding="utf-8").read().strip()
            except OSError:
                src = ""
            if src and os.path.isdir(os.path.join(src, ".git")):
                return (["git", "-C", src, "pull", "--ff-only"],
                        f"git -C {src} pull", "clone", src)
    if dist_ok is None:
        try:
            import importlib.metadata as _md
            _md.distribution("omnigauge")
            dist_ok = True
        except Exception:
            dist_ok = False
    if dist_ok:
        return ([exe, "-m", "pip", "install", "--upgrade", "omnigauge"],
                "pip install --upgrade omnigauge", "pip", None)
    return None, None, "unknown", None


def _update_failed_hint(out):
    """Translate a known failure into the instruction that works. Debian/Ubuntu
    refuse bare pip into the system Python (PEP 668) - re-printing that wall
    and exiting taught nothing; the answer is pipx or the clone route."""
    if "externally-managed" in out:
        return ("this Python refuses package installs (PEP 668 - Debian/Ubuntu policy).\n"
                "  install through pipx instead:  sudo apt install pipx && pipx install omnigauge\n"
                "  or from a clone:  git clone https://github.com/omnigauge/omnigauge && cd omnigauge && bash install.sh")
    return ""


def self_update():
    """`omnigauge --update`: upgrade to the latest release with the same tool
    that installed it, then clear and restart, so the first thing you see is
    the new board with the new version on it. The route comes from
    _update_plan's evidence; with none it says the three routes and stops."""
    cmd, shown, kind, srcdir = _update_plan()
    if not cmd:
        print(f"\n  {s.b}omnigauge --update{s.r}  {s.gry}could not tell how this copy was installed{s.r}")
        print(f"  {s.gry}update it the way it arrived:{s.r}")
        print(f"    pipx:   pipx upgrade omnigauge")
        print(f"    pip:    pip install --upgrade omnigauge")
        print(f"    clone:  git pull && bash install.sh   (stamps itself for next time)")
        sys.exit(1)
    print(f"\n  {s.b}omnigauge --update{s.r}  {s.gry}running:{s.r} {shown}", flush=True)
    print(f"  {s.gry}the tool's own output follows; 'already' anywhere in it means you have the latest{s.r}\n", flush=True)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as ex:
        print(f"  could not run {shown}: {ex}"); sys.exit(1)
    out = (r.stdout or "") + (r.stderr or "")
    sys.stdout.write(out); sys.stdout.flush()
    if r.returncode != 0:
        hint = _update_failed_hint(out)
        if hint:
            print(f"\n  {s.warn}{hint}{s.r}")
        print(f"\n  {shown} exited with {r.returncode}"); sys.exit(r.returncode)
    if kind == "clone" and srcdir and os.path.exists(os.path.join(srcdir, "install.sh")):
        subprocess.run(["bash", os.path.join(srcdir, "install.sh")], cwd=srcdir)
    if sys.stdout.isatty():
        sys.stdout.write("\033[2J\033[H"); sys.stdout.flush()
    prog = shutil.which("omnigauge")
    if prog:
        os.execv(prog, [prog])
    reexec()


def db():
    os.makedirs(DATA, exist_ok=True)
    c = sqlite3.connect(DB)
    c.executescript(SCHEMA)
    for table, col, typ in MIGRATIONS:
        have = {r[1] for r in c.execute(f"PRAGMA table_info({table})")}
        if col not in have:
            c.execute(f"ALTER TABLE {table} ADD COLUMN {col} {typ}")
    c.commit()
    return c


