                  accent="\033[38;5;248m",
                  gry="\033[38;5;240m", faint="\033[38;5;236m", wht="\033[38;5;253m"),
        vivid=dict(ok="\033[92m", warn="\033[93m", crit="\033[91m", accent="\033[96m",
                   gry="\033[90m", faint="\033[90m", wht="\033[97m"),
    )
